<Window
    x:Class="DynamicUniform.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DynamicUniform"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="动态均分布局演示"
    Width="1200"
    Height="800"
    ResizeMode="CanMinimize"
    Background="#252525"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel
            Margin="5" HorizontalAlignment="Left" Orientation="Horizontal">
            <local:RanksLayout
                Title="序列" Margin="10,0,0,0" LayoutChanged="SeriesRanksLayout_OnLayoutChanged" />
            <local:RanksLayout
                Title="图像" Margin="10,0,0,0" LayoutChanged="PictureRanksLayout_OnLayoutChanged" />
        </StackPanel>
        <Grid
            Grid.Row="1" Background="Gray">
            <local:SeriesRanksLayout x:Name="SeriesRanksLayout" />
        </Grid>
    </Grid>
</Window>
